Package: linregpkg
Type: Package
Title: Linear and Ridge Regression with QR Decomposition
Version: 0.2.0
Authors@R: c(
    person("Viet Tien", "Trinh", email = "vietr933@student.liu.se",
           role = c("cre", "aut"),
